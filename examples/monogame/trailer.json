{
  "name": "pretend LAN match",
  "window_match": "Vector Rumble",
  "scene_prefix": "Vector Rumble",
  "work_dir": "video",
  "build": "dotnet build Desktop -c Release -p:DevShots=true -v q --nologo",
  "launch": "caffeinate -d -i dotnet Desktop/bin/Release/net10.0/VectorRumble.dll",
  "kill_pattern": "[V]ectorRumble.dll",
  "max_seconds": 420,
  "settle_seconds": 4,
  "pre_roll": 1.5,
  "release_file": "tour",
  "transition": {"name": "Cut"},

  "env": {
    "TRAILER_CLEANSETTINGS": "1",
    "TRAILER_ALLAI": "1",
    "TRAILER_AI": "3",
    "TRAILER_SEED": "3",
    "TRAILER_SKY": "0",
    "TRAILER_FIREWORKS": "1",
    "TRAILER_SCORELIMIT": "5"
  },

  "instances": [
    {"name": "John", "window": "0,790,1280,720", "ready_cue": "browser-open",
     "env": {"TRAILER_NAME": "{name}", "TRAILER_WIN": "{window}", "TRAILER_OPEN": "browse", "TRAILER_GOFILE": "{work}/go-John", "TRAILER_SHIP": "4", "TRAILER_COLOUR": "2", "TRAILER_DEMOHOP": "1"}},
    {"name": "Jane", "window": "430,790,1280,720", "ready_cue": "browser-open",
     "env": {"TRAILER_NAME": "{name}", "TRAILER_WIN": "{window}", "TRAILER_OPEN": "browse", "TRAILER_GOFILE": "{work}/go-Jane", "TRAILER_SHIP": "0", "TRAILER_COLOUR": "3"}},
    {"name": "Alison", "window": "860,790,1280,720", "ready_cue": "browser-open",
     "env": {"TRAILER_NAME": "{name}", "TRAILER_WIN": "{window}", "TRAILER_OPEN": "browse", "TRAILER_GOFILE": "{work}/go-Alison", "TRAILER_SHIP": "2", "TRAILER_COLOUR": "4", "TRAILER_DEMOHOP": "1"}},
    {"name": "Alex", "window": "0,30,1280,720",
     "env": {"TRAILER_NAME": "{name}", "TRAILER_WIN": "{window}", "TRAILER_OPEN": "main", "TRAILER_PICK": ",,2",
             "TRAILER_TOUR": "Play,Multiplayer,Host a game", "TRAILER_TOURFILE": "{work}/tour", "TRAILER_TOURSTART": "0.6", "TRAILER_RULESHOLD": "1.2",
             "TRAILER_STARTFILE": "{work}/start", "TRAILER_QUITAFTEROVER": "9", "TRAILER_ENDAFTER": "420", "TRAILER_SHIP": "1", "TRAILER_COLOUR": "1", "TRAILER_SKYNAMES": "1"}}
  ],

  "story": [
    {"cut": "Alex"},
    {"wait": "Alex:host-lobby", "timeout": 90},
    {"sleep": 1.0},
    {"cut": "John"},
    {"wait": "John:session-visible", "timeout": 20},
    {"sleep": 0.8},
    {"signal": "go-John"},
    {"wait": "John:joined", "timeout": 30},
    {"sleep": 1.6},
    {"cut": "Jane"},
    {"sleep": 0.4},
    {"signal": "go-Jane"},
    {"wait": "Jane:joined", "timeout": 30},
    {"sleep": 1.2},
    {"cut": "Alison"},
    {"sleep": 0.4},
    {"signal": "go-Alison"},
    {"wait": "Alison:joined", "timeout": 30},
    {"sleep": 1.2},
    {"cut": "Alex"},
    {"sleep": 5.0},
    {"signal": "start"},
    {"wait": "Alex:match-start", "timeout": 20},
    {"wait": "Alex:game-over", "timeout": 900}
  ],

  "edit": {
    "card": {"text": "COMING UP...", "font": "Content/Fonts/Orbitron.ttf", "color": "#ff9a1f"},
    "credits": {"directed_by": "Dominique (SoftSavage) Louis", "implemented_by": "Claude", "at": "end",
                "after": {"player": "Alex", "cue": "game-over", "hold": 5.0}, "seconds": 4, "font": "Content/Fonts/Orbitron.ttf", "color": "#ffffff"},
    "teaser": {"before": 2.55, "length": 3.3},
    "cut": {
      "start": {"cue": "ready", "players": ["John", "Jane", "Alison"], "pick": "last", "offset": 0.85},
      "end": {"player": "Alex", "cue": "match-start", "offset": -0.05}
    }
  }
}
